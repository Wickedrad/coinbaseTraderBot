# ~/bot/bot.env  (the server's settings; chmod 600)
# After editing:  sudo systemctl restart kalshi-bot

# ---- Mode (the dashboard's PAPER / LIVE button rewrites these lines) --------------------------
TRADING_MODE=paper
# prod = real Kalshi prices (paper trades are simulated against them). Needs a PROD API key below.
KALSHI_ENV=prod
# Written by the dashboard when you switch to live; you never type it yourself.
# LIVE_TRADING_ACKNOWLEDGED=I_ACCEPT_REAL_MONEY_RISK
# Perps and tennis have their own switches: LIVE leaves the next three lines as they are (paper perps are off in
# live, tennis only tracks); PAPER sets a live perps line back to paper and TENNIS_LIVE to false.
# PERP_*=live only with TRADING_MODE=live: next to paper the bot does not start.
PERP_TRADING=paper
PERP_HEDGE=paper
TENNIS_LIVE=false

# ---- Dashboard -----------------------------------------------------------------------------
BIND_HOST=0.0.0.0
ALLOW_NON_LOOPBACK_BIND=true
PORT=3000
# Optional login (empty = no login)
DASHBOARD_PASSWORD=

# ---- Kalshi API (prediction markets) --------------------------------------------------------
# kalshi.com > Account & security > API keys > Create key: copy the Key ID here and save the private key
# it shows you to the file below (see the paste commands).
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/.kalshi/private_key.pem

# ---- Kalshi perpetuals (optional: leave empty to use the main key above) ---------------------
KALSHI_PERPS_KEY_ID=
KALSHI_PERPS_PRIVATE_KEY_PATH=

# ---- Live Tennis API (tennis scores) --------------------------------------------------------
LIVE_TENNIS_API_KEY=

# ---- CoinGecko (USDT.D / BTC.D baseline; a free demo key works) ------------------------------
COINGECKO_API_KEY=

# ---- Alerts (optional) ------------------------------------------------------------------------
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ---- Load and training (current defaults; shown so you can change them) -----------------------
CATALOG_STRIKES_PER_EVENT=4
# Strike selection trusts a listing's mid only within this spread (0 = legacy: any mid, else the last price).
CATALOG_PICK_MAX_SPREAD=0.10
# Markets the bot holds nothing in are re-evaluated every EVAL_IDLE_SEC seconds (1 s when it does).
EVAL_IDLE_SEC=5
# remote = trained on GitHub Actions (.github/workflows/train.yml); background = on this server.
AUTO_TRAIN=remote
# Session edges (first/last SESSION_EDGE_MIN minutes of the Asia, London and New York sessions): no entry halt there
# (false, the default with AUTO_TRAIN=remote, paper and live alike). Training runs remotely, so these windows free no
# CPU; session timing should become an input to the heat curve, not a halt on entries.
SESSION_EDGE_MIN=40
SESSION_EDGE_NO_ENTRY=false

# Heat entry lane (docs/HEAT_LANE.md): the oracle's curves open 15-minute and hourly entries, paper and live alike (the
# live pilot budget is the one difference). Off until Steven approves the merge; it needs the plan exits (PLAN_RULES=true)
# and ORDER_USD_MIN above 0, and deploy/heat_reader_install.sh starts the curve reader only while this is true.
HEAT_LANE=false
# Defaults, shown so you can change them (every name is explained in .env.example and docs/HEAT_LANE.md):
# HEAT_CALLS_FILE=/home/ubuntu/bot/data/heat_calls.json
# HEAT_ASSETS=BTC,ETH,SOL,XRP
# HEAT_HORIZONS=15,60
# HEAT_TOP_N=10
# HEAT_MAX_AGE_SEC=90
# HEAT_ENTRY_LAG_SEC=45
# HEAT_SIZING=true
# HEAT_CONTEXT=size
# HEAT_CONTEXT_BOOST=0.25
# HEAT_MAX_OPEN=2
# HEAT_MAX_PER_COIN=1
# HEAT_COOLDOWN_SEC=60
# HEAT_REENTRIES_15M=2
# HEAT_REENTRIES_HOURLY=3
# HEAT_REENTRY_LOSS_STOP=0.5
# HEAT_FLAT_TRIPS=30
# HEAT_PILOT_LOSS_USD=15
# HEAT_FEE_NET_CHECK=false
# HEAT_PERPS=entry
# Perps heat entries on the hour (60) and on 4 hours (240); the daily call only keeps entries against the day out.
# HEAT_PERP_HORIZONS=60,240
# HEAT_PERPS_DAILY=context
# HEAT_PAIR_CONFLICT=skip
# HEAT_READER_MAX_RANK=40
# HEAT_CLOCK_PACK=false
# The reader publishes the perp packs' 4-hour and daily rows (h240, h1440) unless this is false.
# HEAT_PERP_PACKS=true

# TA conviction overlay (bot/strategy/taConviction.ts): the TA network tilts the fair value, TA / confluence
# breadth scales the size, and altcoins in risk-on (USDT.D falling, RSI > 50) get 2.5x and priority.
TA_PRICING=true
TA_PRICING_WEIGHT=1
ALT_RISKON_BOOST=2.5
NON_ALTCOINS=BTC
CONVICTION_MAX_TOTAL=2.5

# ---- Profit exits (current defaults, commented out: uncomment a line to change it) ------------
# Hold exit (Steven, Nov 11): a position whose profit after both fees, sold at the bid, has been at least HOLD_EXIT_USD
# for HOLD_EXIT_SEC seconds in all (a dip does not reset the count) and at least HOLD_EXIT_RUN_USD for the last
# HOLD_EXIT_RUN_SEC seconds in a row is sold at the bid. The quota snipe still sells at once when it reaches its target.
# HOLD_EXIT=true
# HOLD_EXIT_USD=1.50
# HOLD_EXIT_SEC=10
# HOLD_EXIT_RUN_USD=1.00
# HOLD_EXIT_RUN_SEC=3
# After a hold exit or a quota snipe (not a profit ratchet sale alone), the same contract is entered again only on a
# normal entry signal and while more than this share of its window (open to close) is left (0 = no limit).
# HOLD_EXIT_REENTRY_SHARE=0.5
# After this many failed tries on a position (its profit reached HOLD_EXIT_RUN_USD, then stayed under it for
# HOLD_EXIT_RUN_SEC seconds without touching HOLD_EXIT_USD) the line exit may sell it as a last resort, SINUOUS_CROSS off or
# not (0 = never). The hold exit, the profit ratchet and these tries count what partial sales banked plus the rest.
# HOLD_EXIT=false turns this last resort off too (the tries are the hold exit's count).
# HOLD_EXIT_LINE_AFTER_FAILS=5
# Profit ratchet (Steven, Nov 11 8:53 and 8:58 AM EST / 13:53 and 13:58 UTC): every position, plan positions included,
# arms once its profit after both fees is at least RATCHET_ARM_USD; its stop is the larger of RATCHET_STOP_MIN_USD and
# the best profit since less RATCHET_TRAIL_USD, never lowered; at or under the stop the whole position is sold. While it
# is armed and the profit set a new best in the last HOLD_EXIT_RUN_SEC seconds the hold exit waits, so a runner rides it.
# RATCHET=false turns it off for positions that are not plan positions. The hold exit sells plan positions too.
# RATCHET=true
# RATCHET_ARM_USD=1.50
# RATCHET_STOP_MIN_USD=1.00
# RATCHET_TRAIL_USD=0.50
